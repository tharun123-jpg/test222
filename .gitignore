# Build output. Never commit compiled artefacts: the plug-ins are rebuilt from
# source by `make` or CMake, and a stale .aex in the tree is a support ticket
# waiting to happen.
build/
build-*/
cmake-build-*/
# Release packages written by `make release` / `cpack`. These are outputs, not
# sources: they are reproducible from a commit, and a stale tarball in the tree
# is exactly the kind of thing that gets shipped by accident.
dist/
*.tar.gz
*.zip

*.o
*.d
*.a
*.aex
*.plugin
.DS_Store
